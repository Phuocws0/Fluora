generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?
  bio             String?   @db.Text
  avatarUrl       String?
  passwordHash    String?
  googleSubject   String?   @unique
  emailVerifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  settings          UserSettings?
  sessions          Session[]
  authTokens        AuthToken[]
  placementAttempts PlacementAttempt[]
  supportRequests SupportRequest[]
  dataExportRequests DataExportRequest[]
  vocabularySets VocabularySet[]
  bookmarks Bookmark[]
  readingProgress ReadingProgress[]
  reviewItems ReviewItem[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  deviceName String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastUsedAt])
  @@map("sessions")
}

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model UserSettings {
  userId                 String    @id @db.Uuid
  appLanguage            String    @default("en")
  courseLanguage         String?
  motivation             String?
  startingLevel          String?
  dailyGoalMinutes       Int?
  dailyTimeBudgetMinutes Int?
  learningPromise        String?
  reminderEnabled        Boolean   @default(false)
  reminderTime           String?
  reminderDays           Int[]     @default([])
  timezone               String?
  notifyFriendRequests   Boolean   @default(true)
  notifyRewards          Boolean   @default(true)
  notifyReminders        Boolean   @default(true)
  floCompanion           String?
  progressVisibility     String    @default("friends")
  discoverable           Boolean   @default(true)
  saveTutorHistory       Boolean   @default(true)
  textSize               String    @default("default")
  reducedMotion          Boolean   @default(false)
  captions               Boolean   @default(false)
  focusMode              Boolean   @default(false)
  lowBandwidth           Boolean   @default(false)
  wellbeingTimerMinutes  Int?
  onboardingCompletedAt  DateTime?
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PlacementAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  questionSetVersion Int
  answers            Json
  level              String
  skillBaseline      Json
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("placement_attempts")
}

model SupportRequest {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  message       String   @db.Text
  screenshot    String?
  deviceDetails Json
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_requests")
}

model DataExportRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("ready")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_export_requests")
}

model VocabularySet {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards VocabularyCard[]

  @@index([userId, createdAt])
  @@map("vocabulary_sets")
}

model VocabularyCard {
  id String @id @default(uuid()) @db.Uuid
  setId String @db.Uuid
  front String
  back String
  tag String?
  example String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  set VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId, createdAt])
  @@map("vocabulary_cards")
}

model Story {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  kind String
  content Json
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  readingProgress ReadingProgress[]

  @@map("stories")
}

model Bookmark {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  targetType String
  targetId String
  note String?
  tag String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model ReadingProgress {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  storyId String @db.Uuid
  position Int @default(0)
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("reading_progress")
}

model ReviewItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  front String
  back String
  kind String @default("custom")
  nextReviewAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcomes ReviewOutcome[]

  @@index([userId, nextReviewAt])
  @@map("review_items")
}

model ReviewOutcome {
  id String @id @default(uuid()) @db.Uuid
  itemId String @db.Uuid
  correct Boolean
  createdAt DateTime @default(now())
  item ReviewItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("review_outcomes")
}

model Course {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  title            String
  description      String         @db.Text
  language         String
  level            String
  estimatedMinutes Int
  order            Int            @default(0)
  isPublished      Boolean        @default(true)
  units            Unit[]
  learningPaths    LearningPath[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished, order])
  @@map("courses")
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  slug        String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, order])
  @@map("units")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  unitId          String     @db.Uuid
  slug            String
  title           String
  description     String?    @db.Text
  skill           String
  level           String
  durationMinutes Int
  order           Int        @default(0)
  unit            Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([unitId, slug])
  @@index([unitId, order])
  @@index([skill, level])
  @@map("lessons")
}

model Exercise {
  id          String            @id @default(uuid()) @db.Uuid
  lessonId    String            @db.Uuid
  type        String
  prompt      String            @db.Text
  instruction String?           @db.Text
  content     Json
  answerKey   Json
  explanation String?           @db.Text
  order       Int               @default(0)
  lesson      Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options     ExerciseOption[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([lessonId, order])
  @@map("exercises")
}

model ExerciseOption {
  id         String   @id @default(uuid()) @db.Uuid
  exerciseId String   @db.Uuid
  label      String
  value      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
  @@map("exercise_options")
}

model LearningPath {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  slug             String   @unique
  title            String
  summary          String   @db.Text
  careerGoal       String
  targetLanguage   String
  level            String
  estimatedMinutes Int
  estimatedWeeks   Int?
  outcomes         String[] @default([])
  order            Int      @default(0)
  isPublished      Boolean  @default(true)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([courseId, order])
  @@index([isPublished, order])
  @@map("learning_paths")
}
