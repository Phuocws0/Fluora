generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?
  bio             String?   @db.Text
  avatarUrl       String?
  passwordHash    String?
  googleSubject   String?   @unique
  emailVerifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  settings          UserSettings?
  sessions          Session[]
  authTokens        AuthToken[]
  placementAttempts PlacementAttempt[]
  supportRequests SupportRequest[]
  dataExportRequests DataExportRequest[]
  vocabularySets VocabularySet[]
  bookmarks Bookmark[]
  readingProgress ReadingProgress[]
  reviewItems ReviewItem[]
  answers UserAnswer[]
  lessonCompletions LessonCompletion[]
  plannerEntries PlannerEntry[]
  learningEvidence LearningEvidence[]
  missionCompletions MissionCompletion[]
  misconceptionStates MisconceptionState[]
  sentFriendRequests      FriendRequest[]        @relation("FriendRequestsSent")
  receivedFriendRequests  FriendRequest[]        @relation("FriendRequestsReceived")
  notifications           Notification[]
  groupMemberships        GroupMembership[]
  groupPosts              GroupPost[]
  groupComments           GroupComment[]
  challengeParticipations ChallengeParticipant[]
  hostedRooms             StudyRoom[]            @relation("HostedRooms")
  roomParticipations      RoomParticipant[]
  roomMessages            RoomMessage[]
  pollVotes               PollVote[]
  peerReviewComments      PeerReviewComment[]
  planTasks               GroupPlanTask[]
  whiteboardNotes         WhiteboardNote[]
  questClaims             QuestClaim[]
  achievements            UserAchievement[]
  redemptions             RewardRedemption[]
  walletTransactions      WalletTransaction[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  deviceName String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastUsedAt])
  @@map("sessions")
}

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model UserSettings {
  userId                 String    @id @db.Uuid
  appLanguage            String    @default("en")
  courseLanguage         String?
  motivation             String?
  startingLevel          String?
  dailyGoalMinutes       Int?
  dailyTimeBudgetMinutes Int?
  learningPromise        String?
  reminderEnabled        Boolean   @default(false)
  reminderTime           String?
  reminderDays           Int[]     @default([])
  timezone               String?
  notifyFriendRequests   Boolean   @default(true)
  notifyRewards          Boolean   @default(true)
  notifyReminders        Boolean   @default(true)
  floCompanion           String?
  progressVisibility     String    @default("friends")
  discoverable           Boolean   @default(true)
  saveTutorHistory       Boolean   @default(true)
  textSize               String    @default("default")
  reducedMotion          Boolean   @default(false)
  captions               Boolean   @default(false)
  focusMode              Boolean   @default(false)
  lowBandwidth           Boolean   @default(false)
  wellbeingTimerMinutes  Int?
  onboardingCompletedAt  DateTime?
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PlacementAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  questionSetVersion Int
  answers            Json
  level              String
  skillBaseline      Json
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("placement_attempts")
}

model SupportRequest {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  message       String   @db.Text
  screenshot    String?
  deviceDetails Json
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_requests")
}

model DataExportRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  status    String   @default("ready")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("data_export_requests")
}

model VocabularySet {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards VocabularyCard[]

  @@index([userId, createdAt])
  @@map("vocabulary_sets")
}

model VocabularyCard {
  id String @id @default(uuid()) @db.Uuid
  setId String @db.Uuid
  front String
  back String
  tag String?
  example String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  set VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId, createdAt])
  @@map("vocabulary_cards")
}

model Story {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  kind String
  content Json
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  readingProgress ReadingProgress[]

  @@map("stories")
}

model Bookmark {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  targetType String
  targetId String
  note String?
  tag String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model ReadingProgress {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  storyId String @db.Uuid
  position Int @default(0)
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("reading_progress")
}

model ReviewItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  front String
  back String
  kind String @default("custom")
  nextReviewAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcomes ReviewOutcome[]

  @@index([userId, nextReviewAt])
  @@map("review_items")
}

model ReviewOutcome {
  id String @id @default(uuid()) @db.Uuid
  itemId String @db.Uuid
  correct Boolean
  createdAt DateTime @default(now())
  item ReviewItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("review_outcomes")
}

model Course {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  title            String
  description      String         @db.Text
  language         String
  level            String
  estimatedMinutes Int
  order            Int            @default(0)
  isPublished      Boolean        @default(true)
  units            Unit[]
  learningPaths    LearningPath[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([isPublished, order])
  @@map("courses")
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  slug        String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, order])
  @@map("units")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  unitId          String     @db.Uuid
  slug            String
  title           String
  description     String?    @db.Text
  skill           String
  level           String
  durationMinutes Int
  order           Int        @default(0)
  unit            Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  completions     LessonCompletion[]
  missions        Mission[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([unitId, slug])
  @@index([unitId, order])
  @@index([skill, level])
  @@map("lessons")
}

model Exercise {
  id          String            @id @default(uuid()) @db.Uuid
  lessonId    String            @db.Uuid
  type        String
  prompt      String            @db.Text
  instruction String?           @db.Text
  content     Json
  answerKey   Json
  explanation String?           @db.Text
  order       Int               @default(0)
  lesson      Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options     ExerciseOption[]
  answers     UserAnswer[]
  misconceptionStates MisconceptionState[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([lessonId, order])
  @@map("exercises")
}

model ExerciseOption {
  id         String   @id @default(uuid()) @db.Uuid
  exerciseId String   @db.Uuid
  label      String
  value      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
  @@map("exercise_options")
}

model LearningPath {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  slug             String   @unique
  title            String
  summary          String   @db.Text
  careerGoal       String
  targetLanguage   String
  level            String
  estimatedMinutes Int
  estimatedWeeks   Int?
  outcomes         String[] @default([])
  order            Int      @default(0)
  isPublished      Boolean  @default(true)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([courseId, order])
  @@index([isPublished, order])
  @@map("learning_paths")
}

model UserAnswer {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  exerciseId String @db.Uuid
  answer Json
  isCorrect Boolean
  score Int?
  feedback String @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, exerciseId])
  @@map("user_answers")
}

model LessonCompletion {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  lessonId String @db.Uuid
  xpEarned Int
  completedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
  @@map("lesson_completions")
}

model PlannerEntry {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  date String
  time String
  durationMinutes Int
  label String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("planner_entries")
}

model CanDoGoal {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  skill String
  description String @db.Text
  evidence LearningEvidence[]

  @@map("can_do_goals")
}

model LearningEvidence {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  goalId String @db.Uuid
  kind String
  summary String @db.Text
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal CanDoGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([userId, goalId])
  @@map("learning_evidence")
}

model Mission {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  description String @db.Text
  requiredLessonId String? @db.Uuid
  requiredLesson Lesson? @relation(fields: [requiredLessonId], references: [id], onDelete: SetNull)
  completions MissionCompletion[]

  @@map("missions")
}

model MissionCompletion {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  missionId String @db.Uuid
  completedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, completedAt])
  @@map("mission_completions")
}

model MisconceptionState {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  exerciseId String @db.Uuid
  dismissed Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("misconception_states")
}

model FriendRequest {
  id          String    @id @default(uuid()) @db.Uuid
  requesterId String    @db.Uuid
  addresseeId String    @db.Uuid
  pairKey     String    @unique
  status      String    @default("pending")
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  requester   User      @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User      @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friend_requests")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}


model StudyGroup {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  goal        String
  topic       String
  visibility  String            @default("public")
  meetupAt    DateTime?
  meetupNote  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
  posts       GroupPost[]
  challenge   GroupChallenge?
  rooms       StudyRoom[]
  planTasks   GroupPlanTask[]
  notes       WhiteboardNote[]

  @@index([visibility, topic])
  @@map("study_groups")
}

model GroupMembership {
  id       String     @id @default(uuid()) @db.Uuid
  groupId  String     @db.Uuid
  userId   String     @db.Uuid
  role     String     @default("member")
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

model GroupPost {
  id        String         @id @default(uuid()) @db.Uuid
  groupId   String         @db.Uuid
  authorId  String         @db.Uuid
  body      String         @db.Text
  editedAt  DateTime?
  createdAt DateTime       @default(now())
  group     StudyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  GroupComment[]

  @@index([groupId, createdAt])
  @@map("group_posts")
}

model GroupComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  authorId  String    @db.Uuid
  body      String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("group_comments")
}

model GroupChallenge {
  id           String                 @id @default(uuid()) @db.Uuid
  groupId      String                 @unique @db.Uuid
  title        String
  metric       String
  target       Int
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  group        StudyGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@map("group_challenges")
}

model ChallengeParticipant {
  id          String         @id @default(uuid()) @db.Uuid
  challengeId String         @db.Uuid
  userId      String         @db.Uuid
  joinedAt    DateTime       @default(now())
  challenge   GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}


model StudyRoom {
  id           String            @id @default(uuid()) @db.Uuid
  groupId      String            @db.Uuid
  hostId       String            @db.Uuid
  name         String
  focus        String?
  startsAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  group        StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  host         User              @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
  messages     RoomMessage[]
  polls        Poll[]

  @@index([groupId, createdAt])
  @@map("study_rooms")
}

model RoomParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  roomId   String    @db.Uuid
  userId   String    @db.Uuid
  joinedAt DateTime  @default(now())
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_participants")
}

model RoomMessage {
  id        String        @id @default(uuid()) @db.Uuid
  roomId    String        @db.Uuid
  authorId  String        @db.Uuid
  body      String        @db.Text
  replyToId String?       @db.Uuid
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  room      StudyRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   RoomMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   RoomMessage[] @relation("MessageReplies")

  @@index([roomId, createdAt])
  @@map("room_messages")
}

model Poll {
  id        String       @id @default(uuid()) @db.Uuid
  roomId    String       @db.Uuid
  question  String
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  room      StudyRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  choices   PollChoice[]
  votes     PollVote[]

  @@index([roomId, createdAt])
  @@map("polls")
}

model PollChoice {
  id     String     @id @default(uuid()) @db.Uuid
  pollId String     @db.Uuid
  label  String
  order  Int
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@unique([pollId, order])
  @@map("poll_choices")
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  choiceId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  choice    PollChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model PeerReviewSubmission {
  id        String              @id @default(uuid()) @db.Uuid
  slug      String              @unique
  title     String
  prompt    String              @db.Text
  body      String              @db.Text
  authorLabel String
  order     Int                 @default(0)
  comments  PeerReviewComment[]

  @@map("peer_review_submissions")
}

model PeerReviewComment {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @db.Uuid
  authorId     String               @db.Uuid
  body         String               @db.Text
  editedAt     DateTime?
  createdAt    DateTime             @default(now())
  submission   PeerReviewSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@map("peer_review_comments")
}

model GroupPlanTask {
  id          String     @id @default(uuid()) @db.Uuid
  groupId     String     @db.Uuid
  createdById String     @db.Uuid
  title       String
  lane        String     @default("todo")
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  group       StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId, lane, order])
  @@map("group_plan_tasks")
}

model WhiteboardNote {
  id        String     @id @default(uuid()) @db.Uuid
  groupId   String     @db.Uuid
  authorId  String     @db.Uuid
  text      String
  x         Int        @default(0)
  y         Int        @default(0)
  color     String     @default("yellow")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("whiteboard_notes")
}


model Quest {
  id         String       @id @default(uuid()) @db.Uuid
  slug       String       @unique
  title      String
  metric     String
  target     Int
  rewardGems Int
  order      Int          @default(0)
  isActive   Boolean      @default(true)
  claims     QuestClaim[]

  @@map("quests")
}

model QuestClaim {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  questId     String             @db.Uuid
  periodKey   String
  rewardGems  Int
  claimedAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       Quest              @relation(fields: [questId], references: [id], onDelete: Restrict)
  transaction WalletTransaction?

  @@unique([userId, questId, periodKey])
  @@map("quest_claims")
}

model Achievement {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  title       String
  description String
  metric      String
  target      Int
  order       Int               @default(0)
  earned      UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  achievementId String      @db.Uuid
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Reward {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique
  name        String
  description String
  costGems    Int
  kind        String
  fulfillment String
  order       Int                @default(0)
  isActive    Boolean            @default(true)
  redemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  rewardId     String              @db.Uuid
  costGems     Int
  status       String
  createdAt    DateTime            @default(now())
  cancelledAt  DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward       Reward              @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@index([userId, createdAt])
  @@map("reward_redemptions")
}

model WalletTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  amount       Int
  reason       String
  questClaimId String?           @unique @db.Uuid
  redemptionId String?           @db.Uuid
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questClaim   QuestClaim?       @relation(fields: [questClaimId], references: [id], onDelete: NoAction)
  redemption   RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: NoAction)

  @@unique([redemptionId, reason])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}
