{
  "expo": {
    "name": "Fluora",
    "slug": "fluora",
    "scheme": "fluora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluora.mobile"
    },
    "android": {
      "package": "com.fluora.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": "Allow Fluora to record speaking practice on your device." }],
      ["expo-image-picker", { "photosPermission": "Allow Fluora to attach a screenshot to your support request." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
