POSTGRES_DB=fluora
POSTGRES_USER=fluora
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fluora:replace-with-a-local-password@localhost:5433/fluora?schema=public
PORT=4000
# Optional: comma-separated Google OAuth client IDs (Android/iOS/web) accepted by POST /api/auth/google.
# Leave empty to disable Google sign-in (the endpoint returns 503 GOOGLE_SIGN_IN_UNAVAILABLE).
GOOGLE_CLIENT_IDS=

# Public OAuth client IDs used by the mobile Google Sign-In SDK. These are identifiers, not secrets.
# GOOGLE_CLIENT_IDS above must include the web client ID so the backend accepts the returned ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
