POSTGRES_DB=fluora
POSTGRES_USER=fluora
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://fluora:replace-with-a-local-password@localhost:5433/fluora?schema=public
PORT=4000
# Flo Tutor: "local" (offline rules), "openai" (OpenAI-compatible API), or "off".
TUTOR_PROVIDER=local
# Used only with TUTOR_PROVIDER=openai. Keep credentials in the ignored .env file.
# For 9Router on the Docker host, use a reachable host address ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional override for the public local-demo account password documented in README.
DEMO_PASSWORD=
